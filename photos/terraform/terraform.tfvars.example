# =============================================================================
# Immich AWS Infrastructure - Hybrid Model
# =============================================================================
# Your computer runs Immich, AWS S3 stores photos
# Primary bucket (daily use) + Backup bucket (disaster recovery)
# =============================================================================

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------
project_name = "immich"
environment  = "prod"

# -----------------------------------------------------------------------------
# AWS Regions
# -----------------------------------------------------------------------------
# Primary: Where your main bucket lives (closest to you for fast uploads)
# Backup:  Different region for disaster recovery (auto-replicated)
#
# For San Diego, CA:
#   us-west-1 = N. California (closest)
#   us-west-2 = Oregon (backup)
primary_region = "us-west-1"
backup_region  = "us-west-2"

# -----------------------------------------------------------------------------
# S3 Storage Configuration
# -----------------------------------------------------------------------------
# Auto-archive to Glacier Deep Archive for long-term storage
enable_glacier_archive = true
archive_after_days     = 90  # Photos older than 90 days → Glacier ($0.001/GB)

# Enable versioning to protect against accidental deletes
s3_versioning_enabled = true

# -----------------------------------------------------------------------------
# Tags (optional)
# -----------------------------------------------------------------------------
tags = {
  Owner   = "your-name"
  Purpose = "photo-backup"
}
