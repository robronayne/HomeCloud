# =============================================================================
# Media Stack Environment Variables
# =============================================================================
# Copy this file to .env and fill in your credentials
# Get OpenVPN credentials from: https://account.protonvpn.com/account#openvpn
# =============================================================================

# ProtonVPN OpenVPN Credentials (NOT your regular login)
PROTONVPN_USERNAME=your_openvpn_username
PROTONVPN_PASSWORD=your_openvpn_password
