# =============================================================================
# Immich Environment Configuration - Hybrid Model
# =============================================================================
# 1. Copy this file to .env
# 2. Generate DB_PASSWORD: openssl rand -base64 32
# 3. Fill in AWS values from: cd ../terraform && terraform output
# =============================================================================

# -----------------------------------------------------------------------------
# Database (local PostgreSQL in Docker)
# -----------------------------------------------------------------------------
DB_HOSTNAME=database
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_run_openssl_rand_base64_32
DB_DATABASE_NAME=immich

# -----------------------------------------------------------------------------
# Redis (local Redis in Docker)
# -----------------------------------------------------------------------------
REDIS_HOSTNAME=redis

# -----------------------------------------------------------------------------
# Immich
# -----------------------------------------------------------------------------
IMMICH_VERSION=release
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# -----------------------------------------------------------------------------
# AWS S3 - Get these from Terraform output
# -----------------------------------------------------------------------------
# After running 'terraform apply', get values with:
#   terraform output aws_access_key_id
#   terraform output -raw aws_secret_access_key
#   terraform output s3_primary_bucket
#   terraform output primary_region

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
